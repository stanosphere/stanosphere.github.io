---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

// In production, hide drafts. Run `astro dev` locally to see them.
const showDrafts = import.meta.env.DEV;
const posts = (await getCollection("blog"))
  .filter((p) => showDrafts || !p.data.draft)
  .sort(
    (a, b) =>
      (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0),
  );
---

<Base title="stanosphere" description="Paul Stanford's blog">
  <p style="color: var(--muted);">Notes on thing I find interesting.</p>
  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`}>{post.data.title}</a>
          {post.data.draft && <span class="draft-tag">draft</span>}
          <div class="desc">{post.data.description}</div>
          {post.data.pubDate && (
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString("en-GB", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </time>
          )}
        </li>
      ))
    }
  </ul>
  {posts.length === 0 && <p>No posts published yet.</p>}
</Base>
